            "timeout": 60,
            "statusMessage": "Creative Hub deploy gate"
          },
          {
            "type": "command",
            "command": "\"/Users/louisjackson/creative-hub-qa/bin/chqa\" deploy-guard --repo \"${CLAUDE_PROJECT_DIR:-$PWD}\"",
