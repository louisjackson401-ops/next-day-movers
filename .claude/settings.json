{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/louisjackson/creative-hub-qa/bin/chqa\" gate --quiet --repo \"${CLAUDE_PROJECT_DIR:-$PWD}\"",
            "timeout": 60,
            "statusMessage": "Creative Hub QA gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/louisjackson/creative-hub-qa/bin/chqa\" deploy-guard --repo \"${CLAUDE_PROJECT_DIR:-$PWD}\"",
            "if": "Bash(git push*)",
            "timeout": 60,
            "statusMessage": "Creative Hub deploy gate"
          },
          {
            "type": "command",
            "command": "\"/Users/louisjackson/creative-hub-qa/bin/chqa\" deploy-guard --repo \"${CLAUDE_PROJECT_DIR:-$PWD}\"",
